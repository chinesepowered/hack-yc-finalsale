# Copy to .env.local and fill in. Never commit real values.
# Server-side only: read by the Next.js API routes, never sent to the browser.

# YouCam API (AI Clothes cloth-v4, AI Shoes shoes-transfer)
YOUCAM_API_KEY=
# Optional hard cap on YouCam units this server may spend in live mode (default 40)
YOUCAM_UNIT_BUDGET=

# OpenAI-compatible LLM endpoint used to read listing text and photos
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Only for scripts/make-video.mjs (narration). Not used by the app.
ASSEMBLYAI_API_KEY=
